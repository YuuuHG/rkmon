[Unit]
Description=rkmon - lightweight read-only device monitor
Documentation=https://github.com/YuuuHG/rkmon
After=network.target

[Service]
Type=simple
User=rkmon
Group=rkmon
ExecStart=/opt/rkmon/rkmon --config /etc/rkmon/config.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=64M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
